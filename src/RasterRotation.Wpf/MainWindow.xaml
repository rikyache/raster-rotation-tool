<Window x:Class="RasterRotation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RasterRotation.Wpf"
        Title="Raster Rotation Tool"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{x:Static local:MainWindow.OpenCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.HelpCommand}"/>
        <KeyBinding Key="H" Command="{x:Static local:MainWindow.FlipHorizontalCommand}"/>
        <KeyBinding Key="V" Command="{x:Static local:MainWindow.FlipVerticalCommand}"/>
        <KeyBinding Gesture="Ctrl+Left" Command="{x:Static local:MainWindow.RotateLeftCommand}"/>
        <KeyBinding Gesture="Ctrl+Right" Command="{x:Static local:MainWindow.RotateRightCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть..." InputGestureText="Ctrl+O" Click="OpenClick"/>
                <Separator/>
                <MenuItem Header="_Сохранить" InputGestureText="Ctrl+S" Click="SaveClick"/>
                <MenuItem Header="Сохранить _как..." InputGestureText="Ctrl+Shift+S" Click="SaveAsClick"/>
                <Separator/>
                <MenuItem Header="Выход" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="_Правка">
                <MenuItem Header="Повернуть -90" InputGestureText="Ctrl+Left" Click="RotateLeftClick"/>
                <MenuItem Header="Повернуть +90" InputGestureText="Ctrl+Right" Click="RotateRightClick"/>
                <MenuItem Header="Повернуть 180" Click="Rotate180Click"/>
                <Separator/>
                <MenuItem Header="Отразить по горизонтали" InputGestureText="H" Click="FlipHorizontalClick"/>
                <MenuItem Header="Отразить по вертикали" InputGestureText="V" Click="FlipVerticalClick"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem x:Name="GridMenuItem" Header="Сетка" IsCheckable="True" Click="GridMenuClick"/>
            </MenuItem>
            <MenuItem Header="_Справка" Click="HelpClick"/>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Открыть" Click="OpenClick"/>
                <Button Content="Сохранить" Click="SaveClick"/>
                <Separator/>
                <Button Content="-90" Click="RotateLeftClick"/>
                <Button Content="+90" Click="RotateRightClick"/>
                <Button Content="180" Click="Rotate180Click"/>
                <Separator/>
                <Button Content="Гориз." Click="FlipHorizontalClick"/>
                <Button Content="Верт." Click="FlipVerticalClick"/>
                <Separator/>
                <ToggleButton x:Name="CropModeButton" Content="Обрезка" Click="CropModeClick"/>
                <CheckBox x:Name="GridCheckBox" Content="Сетка" VerticalAlignment="Center" Click="GridCheckClick"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusFileText" Text="Файл не открыт"/>
            <Separator/>
            <TextBlock x:Name="StatusSizeText" Text="Размер: -"/>
            <Separator/>
            <TextBlock x:Name="StatusAngleText" Text="Угол: 0"/>
            <Separator/>
            <TextBlock x:Name="StatusFormatText" Text="Формат: -"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="12" Background="{DynamicResource ViewportBrush}" BorderBrush="#B8C1CA" BorderThickness="1">
                <Grid x:Name="ImageHost" ClipToBounds="True">
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" Opacity="0.45" Visibility="Collapsed"/>
                    <Canvas x:Name="CropCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="CropCanvasMouseLeftButtonDown"
                            MouseMove="CropCanvasMouseMove"
                            MouseLeftButtonUp="CropCanvasMouseLeftButtonUp">
                        <Rectangle x:Name="CropRectangle"
                                   Stroke="#1D6F8F"
                                   StrokeThickness="2"
                                   Fill="#331D6F8F"
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="0,12,12,12">
                <TextBlock Text="Свободное вращение" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="AngleSlider"
                            Minimum="-180"
                            Maximum="180"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="AngleSliderValueChanged"/>
                    <TextBox x:Name="AngleTextBox"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             Text="0"
                             TextAlignment="Right"/>
                </Grid>
                <Button Content="Применить угол" Click="ApplyFreeRotationClick" Margin="0,0,0,20"/>

                <TextBlock Text="Сохранение" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="JPEG качество" VerticalAlignment="Center"/>
                    <TextBox x:Name="QualityTextBox" DockPanel.Dock="Right" Width="56" TextAlignment="Right"/>
                </DockPanel>

                <TextBlock Text="Настройки вида" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <TextBlock Text="Тема" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="ThemeComboBox" SelectionChanged="ThemeSelectionChanged" Margin="0,0,0,10">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
                <TextBlock Text="Фон рабочей области" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="BackgroundComboBox" SelectionChanged="BackgroundSelectionChanged">
                    <ComboBoxItem Content="Neutral"/>
                    <ComboBoxItem Content="White"/>
                    <ComboBoxItem Content="Graphite"/>
                </ComboBox>

                <Separator Margin="0,20,0,16"/>
                <TextBlock x:Name="DetailsTextBlock"
                           Text="Откройте изображение через Ctrl+O или передайте путь к файлу при запуске."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
